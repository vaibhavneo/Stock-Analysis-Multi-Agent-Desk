# OAuth tokens (broker/token_store.py's local-dev fallback path). Never
# committed — these are as sensitive as the .env API keys, and this repo
# never had a .gitignore before this file existed, which is exactly how
# data/recommendations.db ended up tracked in git.
data/broker_tokens.json

__pycache__/
*.pyc
*.pyo
.DS_Store
.env

# The live SQLite DB (and its WAL/SHM siblings) churns on every request and
# was accidentally tracked before this file existed - stop tracking it, same
# reasoning as data/broker_tokens.json above.
data/recommendations.db
data/recommendations.db-shm
data/recommendations.db-wal

# Local editor/agent config. Not secret, but machine-specific and not part of
# the project - it appeared as untracked and would be swept in by `git add -A`.
.claude/

# Provider response cache (EDGAR companyfacts, FRED/CBOE macro, yfinance bars).
# Regenerated on demand and rewritten by every test run or replay, so it is
# pure churn in a diff. NOTE: some of these files were already tracked before
# this rule existed; ignoring them here stops NEW ones being added but does not
# untrack the existing ones - that needs a deliberate `git rm --cached`.
financial_data/.cache/

# Heartbeat run logs — local operational output, regenerated daily.
logs/
